# 3L 交易系统 — 环境配置
# 复制此文件为 .env 并按需修改
# 参考: https://github.com/ggchangan/3L

# 项目路径
WWW_DIR=/home/ubuntu/www
DATA_DIR=/home/ubuntu/data/3l

# 服务端口
PORT=8080

# 日志
LOG_LEVEL=INFO
LOG_DIR=/var/log/3l

# 板块业务口径。当前完整主 provider 为 THS；Tushare/直连/缓存只是同一
# 口径下的获取通道。只有实现排行、K线、概念映射完整能力后，其他 provider
# 才允许通过配置整源切换；能力不完整时启动会失败，避免混算。
SECTOR_DATA_PROVIDER=ths
# 同日预估默认读取 THS 原始 K 线；当天未发布时保持 stale、次日补齐。
# eastmoney 仅保留为显式兼容选项，disabled 可完全禁用同日预估。
SECTOR_AUXILIARY_PROVIDER=ths

# 盘中实时行情供应商降级顺序。确认日线仍统一来自 Tushare/MySQL；这里只
# 用于当天尚未确认的价格、成交量和分钟曲线。业务代码统一经过行情路由，
# 不直接依赖供应商。当前支持 tencent；mootdx 仅为 A 股指数降级源。
REALTIME_QUOTE_PROVIDERS=tencent,mootdx

# 远程仓库 (供 setup.sh 使用)
GIT_REMOTE=origin
